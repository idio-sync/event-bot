# Copy to .env and fill in what you use. Everything except TZ is optional.
TZ=America/New_York
REFRESH_MINUTES=240
# "Any older film" re-release threshold, in months
RERELEASE_MONTHS=9
# Comma-separated subset of: charles,senator,parkway,cinemark-towson (Cinemark: see README)
THEATERS=charles,senator,parkway

TMDB_API_KEY=

# Plex server (library + watched state); the token also reads your plex.tv watchlist
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
# Optional; default to Radarr's first quality profile / root folder
RADARR_QUALITY_PROFILE=
RADARR_ROOT_FOLDER=

DISCORD_WEBHOOK_URL=

# Used in Discord messages to link back to the page
PUBLIC_URL=http://192.168.1.10:8080

# Parkway (Eventive) — see README before setting this
PARKWAY_EVENTIVE_KEY=
