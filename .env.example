# Copy to .env and fill in what you use. Everything except TZ is optional.
TZ=America/New_York
REFRESH_MINUTES=240
# "Any older film" re-release threshold, in months
RERELEASE_MONTHS=9
# Comma-separated subset of: charles,senator,parkway,cinemark-towson,warehouse-rotunda (see README)
THEATERS=charles,senator,parkway

TMDB_API_KEY=

# Plex server (library + watched state); the token also reads your plex.tv watchlist
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
# Optional; default to Radarr's first quality profile / root folder
RADARR_QUALITY_PROFILE=
RADARR_ROOT_FOLDER=

# Discord bot (slash commands, /follow, DMs) — see README
DISCORD_BOT_TOKEN=
# Or channel posts only, without a bot
DISCORD_WEBHOOK_URL=
# Starting values for the Settings page: any of watchlist,event,rerelease ("none" = off)
DISCORD_ALERTS=watchlist,event,rerelease
ALERT_RETURN_DAYS=30

# Used in Discord messages to link back to the page
PUBLIC_URL=http://192.168.1.10:8080

# Parkway (Eventive): optional override; blank discovers the website browser key
PARKWAY_EVENTIVE_KEY=

# Parkway program bucket (change when its program changes)
PARKWAY_EVENTIVE_BUCKET=67fb1b7ba2fc1ffee7cc9d0c
# Cinemark upcoming schedule horizon
CINEMARK_DAYS_AHEAD=365
