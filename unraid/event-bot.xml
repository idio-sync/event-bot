<?xml version="1.0"?>
<Container version="2">
  <Name>event-bot</Name>
  <Repository>idiosync000/event-bot:latest</Repository>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Showtimes, re-releases and special screenings at selected Baltimore theaters, with Plex, Radarr and Discord tie-ins.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/png/movie.png</Icon>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="Web page port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/event-bot" Mode="rw" Description="Database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/event-bot</Config>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Description="Time zone" Type="Variable" Display="always" Required="true" Mask="false">America/New_York</Config>
  <Config Name="TMDB API key" Target="TMDB_API_KEY" Default="" Mode="" Description="v3 API key or v4 read access token" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Plex URL" Target="PLEX_URL" Default="" Mode="" Description="e.g. http://192.168.1.10:32400" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Plex token" Target="PLEX_TOKEN" Default="" Mode="" Description="X-Plex-Token; also used for your plex.tv watchlist" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Radarr URL" Target="RADARR_URL" Default="" Mode="" Description="e.g. http://192.168.1.10:7878" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Radarr API key" Target="RADARR_API_KEY" Default="" Mode="" Description="Radarr Settings &gt; General" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Radarr quality profile" Target="RADARR_QUALITY_PROFILE" Default="" Mode="" Description="Name; blank = Radarr's first profile" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Radarr root folder" Target="RADARR_ROOT_FOLDER" Default="" Mode="" Description="Path; blank = Radarr's first root folder" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Discord bot token" Target="DISCORD_BOT_TOKEN" Default="" Mode="" Description="Slash commands, /follow and DMs; then finish setup on the app's Settings page" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Discord webhook" Target="DISCORD_WEBHOOK_URL" Default="" Mode="" Description="Alternative without a bot: channel posts only" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Discord alerts" Target="DISCORD_ALERTS" Default="watchlist,event,rerelease" Mode="" Description="Starting value for Settings: any of watchlist,event,rerelease (none = off)" Type="Variable" Display="advanced" Required="false" Mask="false">watchlist,event,rerelease</Config>
  <Config Name="Alert return days" Target="ALERT_RETURN_DAYS" Default="30" Mode="" Description="Starting value for Settings: alert again after this many days without showings" Type="Variable" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Name="Public URL" Target="PUBLIC_URL" Default="" Mode="" Description="How you reach this page, for links in Discord messages" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Theaters" Target="THEATERS" Default="charles,senator,parkway" Mode="" Description="Comma-separated: charles, senator, parkway, cinemark-towson (Cinemark: see README)" Type="Variable" Display="advanced" Required="false" Mask="false">charles,senator,parkway</Config>
  <Config Name="Refresh minutes" Target="REFRESH_MINUTES" Default="240" Mode="" Description="How often to fetch (minimum 30)" Type="Variable" Display="advanced" Required="false" Mask="false">240</Config>
  <Config Name="Re-release months" Target="RERELEASE_MONTHS" Default="9" Mode="" Description="A film this many months older than the screening counts as a re-release" Type="Variable" Display="advanced" Required="false" Mask="false">9</Config>
  <Config Name="Parkway Eventive key" Target="PARKWAY_EVENTIVE_KEY" Default="" Mode="" Description="See README before setting" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
</Container>
